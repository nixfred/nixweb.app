#!/usr/bin/env bash
# nixweb: make, serve, install and check home-screen web apps on the tailnet.
# No framework, no build step, no npm. Deliberately.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APPS="${NIXWEB_APPS:-$HOME/Projects}"
BOLD=$'\e[1m'; DIM=$'\e[2m'; CY=$'\e[36m'; GR=$'\e[32m'; AM=$'\e[33m'; RD=$'\e[31m'; RS=$'\e[0m'

die(){ printf "${RD}x${RS} %s\n" "$1" >&2; exit 1; }
ok(){  printf "${GR}ok${RS} %s\n" "$1"; }
note(){ printf "${DIM}  %s${RS}\n" "$1"; }

# The tailnet name of THIS host. Everything hangs off this: the phone must be able
# to route to it, and localhost cannot be routed to from a phone.
ts_name(){
  if command -v tailscale >/dev/null 2>&1; then
    tailscale status --json 2>/dev/null | python3 -c \
      'import json,sys;print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null && return 0
  fi
  hostname
}

# An app is named (a folder under $NIXWEB_APPS) or given as a path to its folder.
app_dir(){
  if [ -d "$1" ] && { [ -d "$1/public" ] || [ -f "$1/server.py" ]; }; then (cd "$1" && pwd); else printf '%s\n' "$APPS/$1"; fi
}

# How an app reaches the phone: server.py listens on 127.0.0.1 only, and `tailscale serve`
# terminates HTTPS on the tailnet name and proxies in. Two things follow from that:
#   - the phone gets a SECURE CONTEXT. Service workers, Wake Lock, microphone capture and
#     push are all refused on plain http:// to a non-localhost name.
#   - nothing on the laptop's wifi can reach the port, because it is not bound there.
# The tailscale HTTPS port is the same number as the app port.
need_ts(){ command -v tailscale >/dev/null 2>&1 || die "tailscale not found: the phone reaches the app through it"; }
need_port(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ] || die "not a port: $1"; }
need_server(){
  [ -f "$1/server.py" ] || die "$1/server.py missing: copy it from $ROOT/template/ and move your files into $1/public/"
  [ -d "$1/public" ] || die "$1/public missing: the server publishes only that folder"
}

# Exit 0 if tailscale serve already maps https port $1 to something that is NOT this app.
# `tailscale serve --https=PORT <target>` REPLACES whatever is on that port, and a host often
# runs other services this way, so refuse rather than clobber.
ts_port_taken(){
  tailscale serve status --json 2>/dev/null | python3 -c '
import json, sys
port = sys.argv[1]; ours = "http://127.0.0.1:" + port
d = json.load(sys.stdin) or {}
webs = [d.get("Web") or {}] + [(f or {}).get("Web") or {} for f in (d.get("Foreground") or {}).values()]
for web in webs:
    for key, v in web.items():
        if key.rsplit(":", 1)[-1] != port:
            continue
        if any(h.get("Proxy") != ours for h in (v.get("Handlers") or {}).values()):
            sys.exit(0)
sys.exit(1)' "$1"
}

ts_expose(){
  need_ts; need_port "$1"
  ts_port_taken "$1" && die "tailscale serve already uses https port $1 for something else (see: tailscale serve status). Pick another port."
  local out
  out="$(tailscale serve --bg --https="$1" "http://127.0.0.1:$1" 2>&1)" || die "tailscale serve failed:
$out"
}
ts_unexpose(){ tailscale serve --https="$1" off >/dev/null 2>&1 || true; }

usage(){ cat <<EOF
${BOLD}nixweb${RS}: your own tools, on your phone, over Tailscale.

  ${CY}nixweb new${RS} <name>              copy the template into \$NIXWEB_APPS/<name>
  ${CY}nixweb icons${RS} <name> [letters]  generate every icon size the manifest asks for
  ${CY}nixweb serve${RS} <name> [port]     serve it on the tailnet over HTTPS and print the phone URL
  ${CY}nixweb install${RS} <name> [port]   write + enable a systemd --user unit so it survives reboot
  ${CY}nixweb check${RS} <name|path> [options]   test the app against the NixWeb Standard
        --level N   1 Installable, 2 Dependable (default), 3 Exemplary
        --manual    also print the rules that need a person with a phone
        --url URL   also test the tailnet HTTPS edge        --json   machine-readable
  ${CY}nixweb standard${RS} [--list|--rebuild]   list the rules, or rebuild STANDARD.md from rules.json
  ${CY}nixweb hosts${RS}                   show where you could serve this

Apps live in ${APPS} (override with \$NIXWEB_APPS). The standard is in ${ROOT}/STANDARD.md.
EOF
}

cmd_new(){
  local name="${1:?nixweb new <name>}"; local dest="$APPS/$name"
  [ -e "$dest" ] && die "$dest already exists"
  mkdir -p "$dest"
  cp -r "$ROOT/template/." "$dest/"
  # Stamp the name through the template so nothing says NIXWEB on the home screen.
  # awk and sed to a new file, then mv: portable to macOS, and nothing is deleted.
  local Title Esc f
  Title="$(printf '%s' "$name" | tr '_-' '  ' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)} 1')"
  Esc="$(printf '%s' "$Title" | sed 's/[&/\]/\\&/g')"
  for f in public/index.html public/manifest.webmanifest; do
    sed "s/NIXWEB/${Esc}/g" "$dest/$f" > "$dest/$f.new" && mv "$dest/$f.new" "$dest/$f"
  done
  ok "created $dest"
  note "next: nixweb icons $name  ->  nixweb check $name  ->  nixweb serve $name"
}

cmd_icons(){
  local name="${1:?nixweb icons <name> [letters]}"
  local dir; dir="$(app_dir "$name")/public/icons"
  # Default glyph: the app's initials. Emoji are DELIBERATELY not the default:
  # ImageMagick renders them as a blank tile unless an emoji font is installed,
  # and a blank tile is the exact failure this tool exists to prevent.
  local glyph="${2:-$(printf '%s' "$name" | sed 's/[^A-Za-z]//g' | cut -c1-2 | tr '[:lower:]' '[:upper:]')}"
  local IM; IM="$(command -v magick || command -v convert)" || die "ImageMagick not found (pacman -S imagemagick)"
  # Build in a scratch folder and move the files in only after they are verified, so a bad
  # render never overwrites good icons and nothing has to be deleted.
  local tmp s; tmp="$(mktemp -d)"

  # -alpha off -depth 8: Apple paints transparent pixels black, and an 8-bit RGB PNG is the
  # smallest thing every engine reads.
  for s in 180 192 512; do
    "$IM" -size ${s}x${s} xc:'#0b1018' -fill '#00f0ff' \
      -gravity center -pointsize $((s*42/100)) -annotate 0 "$glyph" -alpha off -depth 8 \
      "$tmp/icon-${s}.png" 2>/dev/null || die "icon render failed (scratch folder: $tmp)"
  done
  # Maskable needs a full-bleed background and the glyph inside the central 80 percent, or
  # Android crops it under a circular mask.
  "$IM" -size 512x512 xc:'#0b1018' -fill '#00f0ff' \
    -gravity center -pointsize 160 -annotate 0 "$glyph" -alpha off -depth 8 "$tmp/icon-maskable-512.png"

  # VERIFY. A tile with one colour means the glyph did not render (missing font,
  # unsupported emoji). Fail loudly rather than shipping an invisible icon.
  local colours
  colours="$("$IM" "$tmp/icon-512.png" -format "%k" info: 2>/dev/null || echo 1)"
  if [ "${colours:-1}" -le 1 ]; then
    die "glyph '$glyph' rendered blank (no font for it). Try letters: nixweb icons $name AB"
  fi
  mkdir -p "$dir"
  mv "$tmp"/icon-*.png "$dir/"
  ok "icons written to $dir  (glyph: $glyph, $colours colours)"
}

cmd_serve(){
  local name="${1:?nixweb serve <name> [port]}"; local port="${2:-8731}"
  local dir; dir="$(app_dir "$name")"; [ -d "$dir" ] || die "no such app: $dir"
  need_port "$port"; need_server "$dir"
  ts_expose "$port"
  # Not `exec`: bash has to stay alive so this trap can take the tailnet mapping down again.
  # $port is expanded NOW (double quotes); a local would be gone by the time the trap fires.
  trap "ts_unexpose $port" EXIT
  local host; host="$(ts_name)"
  printf "\n  ${BOLD}Open this on your phone:${RS}\n\n    ${CY}https://%s:%s${RS}\n\n" "$host" "$port"
  note "Then: Share, Add to Home Screen, and leave 'Open as Web App' on. Test in Safari first."
  note "Choose the final host and port now: an installed app is bound to its origin."
  note "Tailnet only. Python listens on 127.0.0.1; tailscale serve fronts it with HTTPS."
  note "Serving $dir/public. Ctrl-C stops it and removes the tailnet mapping."
  echo
  cd "$dir" && python3 server.py "$port"
}

cmd_install(){
  local name="${1:?nixweb install <name> [port]}"; local port="${2:-8731}"
  local dir; dir="$(app_dir "$name")"; [ -d "$dir" ] || die "no such app: $dir"
  need_port "$port"; need_server "$dir"; need_ts
  ts_port_taken "$port" && die "tailscale serve already uses https port $port for something else (see: tailscale serve status). Pick another port."
  local unit="$HOME/.config/systemd/user/nixweb-$name.service" ts; ts="$(command -v tailscale)"
  mkdir -p "$(dirname "$unit")"
  # The tailnet mapping lives and dies with the unit: ExecStartPost adds it, ExecStopPost
  # removes it (the leading "-" keeps a teardown hiccup from marking the unit failed).
  # If tailscaled is not up yet at boot, ExecStartPost fails, the unit fails, and
  # Restart=on-failure tries again in 3s until it is. Loud and self-healing.
  cat > "$unit" <<UNIT
[Unit]
Description=nixweb: $name

[Service]
WorkingDirectory=$dir
ExecStart=/usr/bin/python3 $dir/server.py $port
ExecStartPost=$ts serve --bg --https=$port http://127.0.0.1:$port
ExecStopPost=-$ts serve --https=$port off
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=default.target
UNIT
  systemctl --user daemon-reload
  systemctl --user enable --now "nixweb-$name.service"
  ok "nixweb-$name.service enabled and started on port $port"
  note "phone URL: https://$(ts_name):$port"
  note "logs: journalctl --user -u nixweb-$name -f"
  note "survive logout: loginctl enable-linger $USER"
  note "remove: systemctl --user disable --now nixweb-$name  (also drops the tailnet mapping)"
}

# The checking is done by standard/check.py, which reads standard/rules.json. Python standard
# library only. See STANDARD.md for what each rule means and why.
cmd_check(){
  local target="${1:?nixweb check <name|path> [--level N] [--manual] [--url URL] [--json]}"; shift
  local dir; dir="$(app_dir "$target")"
  [ -d "$dir" ] || die "no such app: $dir"
  exec python3 "$ROOT/standard/check.py" "$dir" "$@"
}

cmd_standard(){
  case "${1:-}" in
    --rebuild|rebuild) exec python3 "$ROOT/standard/check.py" --standard ;;
    ""|--list|list)    shift || true; exec python3 "$ROOT/standard/check.py" --list "$@" ;;
    *) die "nixweb standard [--list [--level N]] | --rebuild" ;;
  esac
}

cmd_hosts(){
  printf "\n  ${BOLD}Where you can serve this${RS}\n\n"
  printf "  %-14s %s\n" "desk machine" "GPU work, at-home tools, wherever the data already lives"
  printf "  %-14s %s\n" "laptop"       "tools that follow the laptop; down when the lid is shut"
  printf "  %-14s %s\n" "Mac"          "anything needing macOS or Apple APIs"
  printf "  %-14s %s\n" "VPS"          "always on: for tools that must outlive every laptop"
  printf "\n  this host: ${CY}%s${RS}\n\n" "$(ts_name)"
  note "Start where the data already is. Move to a VPS when 'is my laptop awake?' blocks you."
}

case "${1:-}" in
  new)      shift; cmd_new "$@" ;;
  icons)    shift; cmd_icons "$@" ;;
  serve)    shift; cmd_serve "$@" ;;
  install)  shift; cmd_install "$@" ;;
  check)    shift; cmd_check "$@" ;;
  standard) shift; cmd_standard "$@" ;;
  hosts)    shift; cmd_hosts "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1" ;;
esac
